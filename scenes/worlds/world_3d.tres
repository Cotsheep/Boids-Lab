[gd_resource type="Resource" script_class="SimulationWorldDefinition" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/worlds/SimulationWorldDefinition.cs" id="1_definition"]
[ext_resource type="PackedScene" path="res://scenes/worlds/boids_world_3d.tscn" id="2_scene"]

[resource]
script = ExtResource("1_definition")
Title = "三维（3D）"
Scene = ExtResource("2_scene")
ConfigurationPath = "user://boids_lab_3d.cfg"
Instructions = "[color=#78dcca][b]三维观察与领队飞行[/b][/color]
[color=#78dcca][b]快速开始[/b][/color]
初始为暂停的观察模式。点击「开始」或按空格运行；再次按空格暂停。
右键旋转、中键平移、滚轮缩放，Home 按当前观察范围重新取景。
左键选中个体，在「领队」页勾选「设为领队」后自动进入操控；Esc 释放鼠标，F3 再次操控。

[color=#78dcca][b]界面与参数[/b][/color]
「基础」：目标个体数量、随机种子、速度、加速度与转动上限。
「群集」：搜索方式、感知半径，以及分离、对齐、聚集规则。
「领队」：身份、跟随队形、操控与视距。「障碍」：放置、编辑和避障。
「显示」：观察范围、参考网格和边框、选中个体的范围与连线、全体运动方向。
每页独立滚动；切换分类会提交正在编辑的数值，切换世界后回到基础页。
键入数值按 Enter 或离开输入框后提交；除目标数量外，数值控件的上下箭头会立即修改参数。目标数量提交后立即增减，随机种子在重置后生效；运动和规则参数在下一次模拟更新或单步时生效。
参数自动保存，二维与三维各自保留设置。顶部明暗按钮显示当前主题，点击切换，选择自动保存。

[color=#78dcca][b]全局快捷键与暂停[/b][/color]
空格：暂停 / 继续，输入框有焦点或说明打开时也有效，长按只切换一次。
F1：显示 / 隐藏界面并释放鼠标。F2：打开 / 关闭本说明，打开时释放鼠标。
Esc：先关闭说明，否则释放领队操控，或取消障碍物放置；点击说明框外也可关闭。
打开说明保留暂停 / 运行状态，背景操作暂时停用；关闭说明或恢复窗口焦点后不会自动操控领队。
暂停时点击「单步」推进一次模拟更新，之后仍保持暂停；运行时禁用。操控中先按 Esc 释放鼠标，再点击单步。

[color=#78dcca][b]观察模式与边界[/b][/color]
左键轻点选择个体或障碍；再次点击已选个体或点击空白取消选择。
「显示」页的宽度 X、高度 Y、深度 Z 定义模拟范围，独立于相机视野；默认 2560 × 1440 × 1440 世界单位。
调整尺寸后保留全部个体和障碍的位置及当前视角，Home 按新范围重新取景。
靠近边缘逐渐转向，越界后逐步返回；不传送到另一侧。最大加速度为 0 时不能主动返回。
「显示边界」默认关闭，仅控制边框；「显示网格」单独控制底面网格。两个显示开关都不改变边界行为。

[color=#d69cff][b]领队与第三人称操控[/b][/color]
同时只有一名领队。选中其他个体并勾选「设为领队」可转移身份，选中领队后取消勾选可解除身份。
普通个体为橙色，普通选择为金色，领队为紫色，选中领队为粉色。取消普通选择不取消身份。
指定领队后使用透视跟随视角，隐藏边框和网格，个体可在无限世界中移动；指定或转移身份会自动操控，保留当前暂停 / 运行状态。
操控时鼠标调整视角；W/S 按相机视角前后移动，A/D 左右侧移，组合输入不增加速度。俯仰视角可改变前后移动的高度。
领队朝实际运动方向转动，不主动与相机对齐。在「基础 → 朝向转动」开启「限制角速度与角加速度」时平滑转动；关闭时直接对齐速度，速率降到 0.01 或以下保持朝向，停稳后超过 0.02 才恢复跟随。该开关对普通个体也生效，暂停时切换只更新外观，不推进位置。
静止时转动视角不改变领队朝向。松键或退出操控后按最大加速度减速；最大加速度为 0 时不能主动制动，领队仍保留障碍接触约束。
空格暂停时保留操控，可调整视角，个体保持原位姿；继续或单步后才更新运动。输入框有焦点时 WASD 和 F3 不操控领队。
Esc 释放后保留跟随视角，可右键拖动调整视角、选择个体或编辑障碍；暂停时也可调整视角。
关闭本说明后，点击「操控领队」或按 F3 恢复操控。F1、F2、窗口失焦、重置或切换世界均释放鼠标并清空旧输入。
「跟随视距」或滚轮调整相机距离，范围 80–2000，默认 300；Home 恢复默认视距。相机目前可穿过障碍物。
「淡化近处个体」减轻近镜头遮挡；领队和选中个体保持高亮，淡化后仍可点击选择。
其他个体跟随领队身后的区域，同时保留分离、对齐、聚集和避障；跟随权重为 0 时关闭跟随。
取消领队后，在群体附近恢复观察模式并引导范围外个体返回；位置不会传送。数量减为 0 时在最后领队位置恢复观察范围。

[color=#78dcca][b]数量与重置[/b][/color]
调整目标数量后保留已有个体的运动状态；缩减时优先保留领队和选中个体。新增个体避开障碍，在观察范围内或领队群体附近生成。
未达到目标数量时显示实际数量；调整范围或障碍后按 Enter 重试。
「重置」在当前观察范围内按数量和种子重新生成并暂停，清除选择、领队和操控状态，保留障碍物。

[color=#78dcca][b]障碍物编辑与避障[/b][/color]
点击「添加长方体」或「添加球体」，移动鼠标查看橙色预览，左键放置；Esc、右键或「取消放置」结束预览。
拖动已选障碍物移动位置；在障碍页修改宽度 X、高度 Y、深度 Z 或直径。鼠标位于选中障碍物上时，Shift + 滚轮等比缩放。
Delete 或「删除障碍物」删除当前障碍；编辑输入框时 Delete 保留文字编辑功能。
放置与拖动使用固定的视角平面，允许超出观察范围；领队模式编辑期间相机暂时停止跟随，结束后恢复。放置前可先调整视角以确定编辑方向。
普通个体开启避障后提前转向，接触时阻挡并沿表面滑动；关闭后普通个体可穿过障碍。
领队由你操控绕行，始终保留接触阻挡和滑动，即使关闭避障也不会穿过障碍。
「前瞻时间」越大越早避让；「避障间距」按个体中心到障碍表面的距离计算。选中个体并开启「显示运动方向」可查看前方探测、受阻/畅通候选、最终方向和接触法线。暂停编辑不移动个体，新增重叠在后续模拟更新或单步时处理。
障碍布局在本次运行中保留，切换世界或退出后清空；重置只重新生成群体。

[color=#78dcca][b]群集、调试与统计[/b][/color]
按真实三维坐标和直线距离查找邻居，朴素遍历与均匀网格得到相同结果，均不包含自身。
分离使近邻相互远离，对齐协调方向，聚集靠近邻居中心；三条规则可分别开关，权重范围为 0–50，不保证个体间的硬性最小距离。实际分离范围不超过感知半径，超出时提醒并保留输入值。
[color=#78dcca]青绿线框球[/color]：感知范围。[color=#ffad5c]橙色线框球[/color]：实际分离范围。[color=#ffd36b]金色连线[/color]：选中个体的邻居。[color=#70baff]蓝色箭头[/color]：全体运动方向。
范围与连线需要先选中个体；参考网格不参与邻居搜索。所有线段和范围均可延伸到观察盒外。
统计显示最近一次模拟更新的读数，每 0.25 秒刷新；-- 表示暂无有效读数。暂停保留上次结果，重置或修改查询条件后，在继续或单步时重新测量。
顶部「二维 / 三维」切换后按各自参数重新生成并暂停，清除运动、选择、领队、障碍和视角，保留界面显隐及明暗主题。"
