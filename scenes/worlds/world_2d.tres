[gd_resource type="Resource" script_class="SimulationWorldDefinition" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/worlds/SimulationWorldDefinition.cs" id="1_definition"]
[ext_resource type="PackedScene" path="res://scenes/worlds/boids_world_2d.tscn" id="2_scene"]

[resource]
script = ExtResource("1_definition")
Title = "二维（2D）"
Scene = ExtResource("2_scene")
ConfigurationPath = "user://boids_lab.cfg"
Instructions = "[color=#78dcca][b]二维观察与鼠标领队[/b][/color]
[color=#78dcca][b]快速开始[/b][/color]
初始为暂停状态。点击「开始」或按空格运行；再次按空格暂停。
左键选中一个个体后，可在「领队」页勾选「设为领队」，用鼠标引导群体。
暂停时点击「单步」推进一次模拟更新，之后仍保持暂停。

[color=#78dcca][b]界面与参数[/b][/color]
「基础」：目标个体数量、随机种子、速度、加速度与转动上限。
「群集」：搜索方式、感知半径，以及分离、对齐、聚集规则。
「领队」：指定或取消领队、跟随距离与权重。「障碍」：放置、编辑和避障。
「显示」：视口软边界、参考网格、选中个体的范围与连线、全体运动方向。
每页独立滚动；切换分类会提交正在编辑的数值，切换世界后回到基础页。
数值按 Enter 或离开输入框后提交。目标数量立即增减，随机种子在重置后生效；运动和规则参数在下一次模拟更新或单步时生效。
修改参数会自动保存。二维、三维分别保存参数；明暗主题共用，顶部按钮文字表示当前主题。

[color=#78dcca][b]键盘与视角[/b][/color]
空格：暂停 / 继续，输入框有焦点或说明打开时也有效，长按只切换一次。
F1：显示 / 隐藏界面。F2：打开 / 关闭本说明，界面隐藏时仍可使用。
Esc：关闭说明；说明关闭时取消障碍物放置。点击说明框外也可关闭。
左键轻点：选择个体或障碍物；再次点击已选个体或点击空白取消选择。
拖动空白处：平移视角。滚轮：以鼠标位置缩放。Home：重置视角。
编辑输入框时，Home 和 Delete 保留文字编辑功能。
打开说明保留暂停 / 运行状态，背景的视角、选择和参数操作暂时停用。

[color=#d69cff][b]领队与边界[/b][/color]
同时只有一名领队。选中其他个体后勾选「设为领队」可转移身份；选中领队后取消勾选可解除身份。
领队用紫色本体和菱形标记；选中领队时保留金色圆环。取消普通选择不取消领队。
领队跟随场景中的鼠标目标，接近后减速。暂停时可更新目标，继续或单步后才移动。
操作界面、打开说明、编辑障碍或窗口失焦时，保留最后的目标。
其他个体跟随领队身后的区域；「领队后方距离」控制到区域前缘的间隔，跟随权重为 0 时关闭跟随。
观察模式默认以当前可见区域环绕，越界从对侧进入；平移或缩放会更新环绕范围。
在「显示 → 二维观察边界」勾选「使用视口软边界」后，边界在视口四周各外扩 10%，靠近边界逐渐向内转向，越界后逐步返回，不再传送。平移、缩放、Home 和窗口变化会更新范围，保留个体当前位置；暂停时不会主动回归。
领队模式为无限世界，离开画面后仍继续移动；相机操作只改变观察位置。
取消领队或删除领队后，按保存设置恢复软边界或环绕；软边界保留远处个体位置，环绕立即将其带回当前视口。重置仍在当前视口内重新生成。

[color=#78dcca][b]数量与重置[/b][/color]
调整目标数量后保留已有个体的运动状态；缩减时优先保留领队和选中个体。
新增个体避开障碍，在观察范围内或领队群体附近生成；未达到目标时显示实际数量，调整范围或障碍后按 Enter 重试。
「重置」按当前数量、种子与范围重新生成群体并暂停，清除选择、领队、目标和统计读数，保留障碍物。

[color=#78dcca][b]障碍物编辑与避障[/b][/color]
点击「添加矩形」或「添加圆形」，移动鼠标查看橙色预览，左键放置；Esc、右键或「取消放置」结束预览。
拖动已选障碍物移动位置；矩形右下角手柄调整宽高，圆形右侧手柄调整直径，也可在障碍页输入尺寸。
鼠标位于选中障碍物上时，Shift + 滚轮等比缩放。Delete 或「删除障碍物」删除当前障碍。
暂停和运行时均可编辑障碍。打开说明会结束未完成的放置或拖动。
启用避障后，个体提前转向，接触时阻挡并沿表面滑动；关闭后所有个体均可穿过障碍物。
「前瞻时间」越大越早避让；「避障间距」按个体中心到障碍表面的距离计算。选中个体并开启「显示运动方向」可查看前方探测、受阻/畅通候选、最终方向和接触法线。
领队结合鼠标目标选择避让方向；增大「避障间距」会增加通过缝隙所需的宽度。
障碍布局在本次运行中保留，切换世界或退出后清空；重置只重新生成群体。

[color=#78dcca][b]群集、调试与统计[/b][/color]
分离保持间距，对齐协调方向，聚集靠近邻居中心；三条规则可分别开关，权重范围为 0–50。
实际分离范围取分离半径与感知半径的较小值；超出感知半径时显示提醒并保留输入值。
最大加速度为 0 时，个体不能主动加速、转向或制动；转动上限控制外观朝向，不直接改变速度方向。
感知范围、分离范围和邻居连线只显示选中个体；运动方向对全体个体生效。
[color=#78dcca]青绿圆圈[/color]：感知范围。[color=#ffad5c]橙色圆圈[/color]：实际分离范围。
[color=#70baff]蓝色箭头[/color]：运动方向。[color=#ffd36b]金色个体与圆环[/color]：普通选择；[color=#ffd36b]金色连线[/color]：邻居关系。
朴素遍历与均匀网格查找相同邻居；背景参考网格不参与搜索。视口软边界和领队模式使用直线距离，环绕观察模式考虑对侧邻居。
统计显示最近一次模拟更新的读数，每 0.25 秒刷新；-- 表示暂无有效读数。暂停保留上次结果，重置或修改查询条件后，在继续或单步时重新测量。

[color=#78dcca][b]切换世界[/b][/color]
顶部「二维 / 三维」选择器按目标世界保存的参数重新生成群体并暂停。
切换后清除个体状态、选择、领队、障碍和相机视角；保留界面显隐及明暗主题。"
